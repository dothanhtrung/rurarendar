import { Palette, AppPage, Theme } from "theme-default.slint";
import { Chrome, Calendar, Sync, Profiles, Feeds, Motion } from "demo-data.slint";
import { I18n } from "i18n.slint";
import { Sidebar } from "sidebar.slint";
import { Header } from "header.slint";
import { MonthView } from "month-view.slint";
import { WeekView } from "week-view.slint";
import { DayView } from "day-view.slint";
import { EventListView } from "event-list-view.slint";
import { SettingsView } from "settings-view.slint";
import { AboutView } from "about-view.slint";
import { JumpPopup, EventSheet, DayListPopup, ProfileSheet, IcalSheet } from "overlays.slint";

export { Palette, Chrome, Calendar, Sync, I18n, Theme, Profiles, Feeds, Motion }

component PeriodPane inherits Rectangle {
    clip: true;
    vertical-stretch: 1;
    horizontal-stretch: 1;
    // Set while placing the incoming page, so that step does not animate.
    private property <bool> snap: false;
    private property <length> shift: 0px;
    private property <int> seq: Motion.period-seq;
    animate shift {
        duration: snap || !Motion.enabled ? 0ms : 130ms;
        easing: ease-out;
    }

    changed seq => {
        if (!Motion.enabled) {
            return;
        }
        root.snap = true;
        root.shift = Motion.period-dir < 0 ? -min(root.width * 0.12, 64px) : min(root.width * 0.12, 64px);
        root.snap = false;
        root.shift = 0px;
    }

    VerticalLayout {
        x: root.shift;
        width: parent.width;
        height: parent.height;
        if (Chrome.page == AppPage.month): MonthView { }
        if (Chrome.page == AppPage.week): WeekView { }
        if (Chrome.page == AppPage.day): DayView { }
    }
}

// Stays in the tree so the close can pop out, then hides when the motion ends.
component PopupLayer inherits Rectangle {
    in property <bool> open;
    out property <float> reveal: open ? 1 : 0;
    width: 100%;
    height: 100%;
    visible: open || reveal > 0;
    animate reveal {
        duration: Motion.enabled ? 110ms : 0ms;
        easing: ease-out;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        opacity: max(root.reveal, 0);
        @children
    }
}

export component AppWindow inherits Window {
    title: I18n.app-name;
    full-screen: false;
    preferred-width: Chrome.phone ? 412px : 1440px;
    preferred-height: Chrome.phone ? 915px : 900px;
    min-width: Chrome.phone ? 360px : 1280px;
    min-height: Chrome.phone ? 640px : 720px;
    background: Palette.bg-app;
    default-font-family: Palette.font-ui;
    default-font-size: 14px;
    forward-focus: back-keys;

    // Key.Back is the Android back gesture. Rejecting it lets the activity finish.
    back-keys := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Back && Chrome.go-back()) {
                return accept;
            }
            return reject;
        }

        // Keep interactive chrome in the OS safe area (status bar / gesture inset).
        safe := Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: max(root.width - root.safe-area-insets.left - root.safe-area-insets.right, 0px);
        height: max(root.height - root.safe-area-insets.top - root.safe-area-insets.bottom, 0px);

        HorizontalLayout {
            if (!Chrome.phone): Sidebar { }
            VerticalLayout {
                Header { }
                if (Chrome.page == AppPage.day || Chrome.page == AppPage.week || Chrome.page == AppPage.month): PeriodPane { }
                if (Chrome.page == AppPage.events): EventListView { }
                if (Chrome.page == AppPage.settings): SettingsView { }
                if (Chrome.page == AppPage.about): AboutView { }
            }
        }

        // Phone: the drawer stays mounted so it can slide off, not vanish.
        if (Chrome.phone): Rectangle {
            y: Palette.header-height;
            width: 100%;
            height: parent.height - Palette.header-height;
            clip: true;
            property <length> travel: Chrome.sidebar-open ? 0px : -Palette.sidebar-width;
            property <float> veil: Chrome.sidebar-open ? 1 : 0;
            animate travel { duration: Motion.enabled ? 140ms : 0ms; easing: ease-out; }
            animate veil { duration: Motion.enabled ? 140ms : 0ms; easing: ease-out; }
            visible: Chrome.sidebar-open || travel > -Palette.sidebar-width;

            TouchArea {
                width: 100%;
                height: 100%;
                enabled: Chrome.sidebar-open;
                clicked => {
                    Chrome.sidebar-open = false;
                }
                Rectangle {
                    background: Palette.overlay;
                    opacity: veil;
                }
            }
            Sidebar {
                close-on-navigate: true;
                x: travel;
                y: 0px;
                height: 100%;
            }
        }

        jump-layer := PopupLayer {
            open: Chrome.jump-open;
            JumpPopup { reveal: jump-layer.reveal; }
        }
        day-layer := PopupLayer {
            open: Chrome.day-list-open;
            DayListPopup { reveal: day-layer.reveal; }
        }
        event-layer := PopupLayer {
            open: Chrome.event-sheet-open;
            EventSheet { reveal: event-layer.reveal; }
        }
        profile-layer := PopupLayer {
            open: Chrome.profile-sheet-open;
            ProfileSheet { reveal: profile-layer.reveal; }
        }
        ical-layer := PopupLayer {
            open: Feeds.sheet-open;
            IcalSheet { reveal: ical-layer.reveal; }
        }
        }
    }
}
