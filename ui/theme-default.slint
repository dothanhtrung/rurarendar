    out property <brush> bg-day-weekend: active.bg-day-weekend;
    out property <brush> bg-day-holiday: active.bg-day-holiday;
    out property <brush> bg-day-tiet-khi: active.bg-day-tiet-khi;
    out property <brush> text-primary: active.text-primary;
    out property <brush> text-secondary: active.text-secondary;
    out property <brush> text-muted: active.text-muted;
    out property <brush> lunar-day: active.lunar-day;
