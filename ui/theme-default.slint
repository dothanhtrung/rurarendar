// Color schemes. Tokens stay stable; E-ink, Gruvbox, and Modern each supply light and dark.
// Theme.scheme-index: 0 E-ink, 1 Gruvbox, 2 Modern.
// Theme.mode-index: 0 auto (system), 1 light, 2 dark. Unknown system scheme counts as light.

import { Palette as WidgetPalette } from "std-widgets.slint";

export enum AppPage { day, week, month, settings, about }

export struct DayCellData {
    gregorian: int,
    month: int,
    year: int,
    lunar: string,
    lunar-day: int,
    lunar-month: int,
    lunar-leap: bool,
    lunar-month-name: string,
    year-can-chi: string,
    month-can-chi: string,
    day-can-chi: string,
    hour-can-chi: string,
    weekday-name: string,
    in-month: bool,
    today: bool,
    weekend: bool,
    holiday: bool,
    tiet-khi: bool,
    tiet-khi-name: string,
    tiet-khi-time: string,
    has-event: bool,
    title: string,
}

export struct TimedEvent {
    day: int,
    start-hour: float,
    hours: float,
    title: string,
    holiday: bool,
    // Empty for blocks that are not a stored user event.
    id: string,
    enabled: bool,
}

export struct DayEvent {
    time: string,
    title: string,
    // Empty for holidays and other rows that cannot be edited.
    id: string,
    enabled: bool,
}

export struct ProfileRow {
    id: string,
    name: string,
    enabled: bool,
    active: bool,
}

struct Swatch {
    bg-app: brush,
    bg-surface: brush,
    bg-sidebar: brush,
    bg-sidebar-hover: brush,
    bg-sidebar-active: brush,
    bg-header: brush,
    bg-panel: brush,
    bg-cell: brush,
    bg-hover: brush,
    bg-day-weekday: brush,
    bg-day-weekend: brush,
    bg-day-holiday: brush,
    bg-day-tiet-khi: brush,
    text-primary: brush,
    text-secondary: brush,
    text-muted: brush,
    lunar-day: brush,
    text-on-sidebar: brush,
    text-on-sidebar-muted: brush,
    text-on-accent: brush,
    text-on-ink: brush,
    text-on-event: brush,
    text-holiday: brush,
    mark-holiday: brush,
    mark-festival: brush,
    mark-tiet-khi: brush,
    mark-event: brush,
    mark-today: brush,
    accent: brush,
    ink: brush,
    rule: brush,
    border: brush,
    selected-ring: brush,
    overlay: brush,
    event-block: brush,
    shadow: brush,
    sidebar-rule: brush,
}

export global Theme {
    in-out property <int> scheme-index: 2;
    in-out property <int> mode-index: 0;
    // WidgetPalette reports the platform scheme (dark, light, or unknown).
    private property <bool> system-dark: WidgetPalette.color-scheme == ColorScheme.dark;
    // Resolved appearance. Auto follows the platform; ColorScheme.unknown stays light.
    out property <bool> dark: mode-index == 2 || (mode-index != 1 && system-dark);
    callback scheme-changed(int);
    callback mode-changed(int);

    // Header sun/moon: leave Auto and pin the opposite of what is on screen.
    public function toggle-explicit() {
        if (dark) {
            mode-index = 1;
        } else {
            mode-index = 2;
        }
        mode-changed(mode-index);
    }
}

