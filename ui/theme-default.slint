    out property <brush> mark-today: active.mark-today;
    out property <brush> accent: active.accent;
    out property <brush> ink: active.ink;
    out property <brush> rule: active.rule;
    out property <brush> border: active.border;
    out property <brush> selected-ring: active.selected-ring;
    out property <brush> overlay: active.overlay;
    out property <brush> event-block: active.event-block;
    out property <brush> shadow: active.shadow;
    out property <brush> sidebar-rule: active.sidebar-rule;

    out property <length> sidebar-width: 232px;
    out property <length> header-height: 64px;
    out property <length> peek-width: 344px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 24px;
    out property <length> radius: 10px;
    out property <length> radius-sm: 6px;

    out property <string> font-ui: "Noto Sans";
    out property <string> font-display: Theme.scheme-index == 2 ? "Noto Sans" : "Noto Serif";
}
