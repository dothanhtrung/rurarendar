    private property <Swatch> active: {
        if (Theme.scheme-index == 1) {
            return Theme.dark ? gruvbox-dark : gruvbox-light;
        }
        if (Theme.scheme-index == 2) {
            return Theme.dark ? modern-dark : modern-light;
        }
        return Theme.dark ? eink-dark : eink-light;
    };

    out property <brush> bg-app: active.bg-app;
    out property <brush> bg-surface: active.bg-surface;
    out property <brush> bg-sidebar: active.bg-sidebar;
    out property <brush> bg-sidebar-hover: active.bg-sidebar-hover;
    out property <brush> bg-sidebar-active: active.bg-sidebar-active;
    out property <brush> bg-header: active.bg-header;
    out property <brush> bg-panel: active.bg-panel;
