import { ScrollView } from "std-widgets.slint";
import { Palette, ProfileColor, TimedEvent, AppPage } from "theme-default.slint";
import { Calendar, Chrome } from "demo-data.slint";
import { PeriodGesture, DateTouchArea } from "widgets.slint";

component WeekBlock inherits Rectangle {
    in property <TimedEvent> ev;
    in property <length> hour-h;
    in property <int> start-hour;
    border-radius: Palette.radius-sm;
    opacity: ev.enabled ? 1 : 0.45;
    background: ev.holiday ? Palette.bg-day-holiday : ev.color >= 0 ? ProfileColor.at(ev.color) : Palette.event-block;
    Rectangle {
        border-radius: parent.border-radius;
        background: root.ev.holiday ? Palette.accent : Palette.text-on-event;
        opacity: event-touch.pressed ? 0.2 : event-touch.has-hover ? 0.1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
    }
    VerticalLayout {
        padding: 6px;
        Text {
            text: ev.title;
            color: ev.holiday ? Palette.text-holiday : Palette.text-on-event;
            font-size: 0.8rem;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: "\{ev.start-hour}";
            color: ev.holiday ? Palette.text-secondary : Palette.text-on-event;
            font-size: 0.7rem;
            opacity: 0.85;
        }
    }
    event-touch := TouchArea {
        enabled: root.ev.id != "";
        mouse-cursor: pointer;
        clicked => {
            if (root.ev.id != "") {
                Calendar.open-event(root.ev.id);
            }
        }
    }
}

export component WeekView inherits Rectangle {
    background: Palette.bg-app;
    vertical-stretch: 1;
    horizontal-stretch: 1;
    private property <length> min-hour-h: 36px;
    private property <int> start-hour: Calendar.week-hour-start;
    private property <int> hour-count: Calendar.week-hour-count;
    private property <int> focus-row: Calendar.week-row;
    // The hour grid keeps scrolling when the day does not fit. Otherwise it pages weeks.
    private property <bool> hours-scroll: sv.visible-height / hour-count < min-hour-h;
    private property <length> hour-h: hours-scroll ? min-hour-h : sv.visible-height / hour-count;
    private property <length> grid-h: hours-scroll ? hour-count * min-hour-h : sv.visible-height;

    function open-day(index: int) {
        Calendar.week-row = -1;
        Calendar.select-week-day(index);
        Chrome.open(AppPage.day);
    }

    function column-chosen(d: int) -> bool {
        return Calendar.week-days[d].year == Calendar.selected.year && Calendar.week-days[d].month == Calendar.selected.month && Calendar.week-days[d].gregorian == Calendar.selected.gregorian;
    }

    function date-focused(d: int) -> bool {
        return root.column-chosen(d) && Calendar.week-row < 0;
    }

    function hour-focused(d: int) -> bool {
        return root.column-chosen(d) && Calendar.week-row >= 0;
    }

    changed focus-row => {
        if (root.focus-row < 0 || !root.hours-scroll) {
            return;
        }
        let top = root.focus-row * root.hour-h;
        let bottom = top + root.hour-h;
        let view-top = -sv.content-y;
        if (top < view-top) {
            sv.content-y = -top;
        } else if (bottom > view-top + sv.visible-height) {
            sv.content-y = -(bottom - sv.visible-height);
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 0;

        HorizontalLayout {
            padding-bottom: 8px;
            PeriodGesture { width: 56px; horizontal-stretch: 0; }
            for d in 7: Rectangle {
                horizontal-stretch: 1;
                border-radius: Palette.radius-sm;
                background: root.date-focused(d) ? Palette.bg-hover : Calendar.week-days[d].holiday ? Palette.bg-day-holiday : transparent;
                border-width: root.date-focused(d) ? 2px : Calendar.week-days[d].today ? 1px : 0;
                border-color: root.date-focused(d) ? Palette.selected-ring : Palette.mark-today;
                Rectangle {
                    border-radius: parent.border-radius;
                    background: Palette.accent;
                    opacity: date-touch.pressed ? 0.18 : date-touch.has-hover ? 0.08 : 0;
                    animate opacity { duration: 120ms; easing: ease-out; }
                }
                PeriodGesture {
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: Calendar.weekdays[d];
                            color: Palette.text-muted;
                            font-size: 0.75rem;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: Calendar.week-days[d].gregorian;
                            font-family: Palette.font-display;
                            font-size: 1.2rem;
                            font-weight: 600;
                            color: Calendar.week-days[d].holiday ? Palette.text-holiday : Calendar.week-days[d].today ? Palette.mark-today : Palette.text-primary;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: Calendar.week-days[d].lunar;
                            color: Calendar.week-days[d].lunar-day == 1 || Calendar.week-days[d].lunar-day == 15 ? Palette.text-holiday : Palette.lunar-day;
                            font-size: 0.75rem;
                            horizontal-alignment: center;
                        }
                        if (Calendar.week-days[d].title != ""): Text {
                            text: Calendar.week-days[d].title;
                            color: Calendar.week-days[d].holiday ? Palette.text-holiday : Palette.text-secondary;
                            font-size: 0.65rem;
                            overflow: elide;
                            horizontal-alignment: center;
                            wrap: no-wrap;
                        }
                        if (Calendar.week-days[d].mark0 >= 0): HorizontalLayout {
                            alignment: center;
                            spacing: 3px;
                            height: 8px;
                            if (Calendar.week-days[d].mark0 >= 0): Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: ProfileColor.at(Calendar.week-days[d].mark0);
                            }
                            if (Calendar.week-days[d].mark1 >= 0): Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: ProfileColor.at(Calendar.week-days[d].mark1);
                            }
                            if (Calendar.week-days[d].mark2 >= 0): Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: ProfileColor.at(Calendar.week-days[d].mark2);
                            }
                        }
                    }
                    date-touch := DateTouchArea {
                        held => {
                            Calendar.week-row = -1;
                            Calendar.select-week-day(d);
                            Chrome.day-list-open = true;
                        }
                        double-clicked => {
                            Chrome.day-list-open = false;
                            root.open-day(d);
                        }
                    }
                }
            }
        }

        PeriodGesture {
            vertical: !root.hours-scroll;
            vertical-stretch: 1;
            horizontal-stretch: 1;

            sv := ScrollView {
                vertical-stretch: 1;
                mouse-drag-pan-enabled: true;
                content-height: root.hours-scroll ? root.grid-h + 8px : root.grid-h;

                Rectangle {
                    width: 100%;
                    height: root.grid-h;

                    for h in hour-count: Rectangle {
                        y: h * hour-h;
                        height: hour-h;
                        width: 100%;
                        HorizontalLayout {
                            Text {
                                width: 56px;
                                text: "\{h + start-hour}:00";
                                color: Palette.text-muted;
                                font-size: 0.75rem;
                                horizontal-alignment: right;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-width: 1px;
                                border-color: Palette.rule;
                                HorizontalLayout {
                                    for d in 7: Rectangle {
                                        horizontal-stretch: 1;
                                        border-width: 1px;
                                        border-color: Palette.rule;
                                        background: Calendar.week-days[d].holiday ? Palette.bg-day-holiday : (d == 5 || d == 6) ? Palette.bg-day-weekend : transparent;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: 56px;
                        width: parent.width - 56px;
                        height: 100%;
                        HorizontalLayout {
                            for d in 7: Rectangle {
                                horizontal-stretch: 1;
                                Rectangle {
                                    y: Math.clamp(Math.floor(hour-touch.mouse-y / root.hour-h), 0, root.hour-count - 1) * root.hour-h;
                                    height: root.hour-h;
                                    width: 100%;
                                    background: Palette.accent;
                                    opacity: hour-touch.pressed ? 0.18 : hour-touch.has-hover ? 0.08 : 0;
                                    animate opacity { duration: 120ms; easing: ease-out; }
                                }
                                if (root.hour-focused(d)): Rectangle {
                                    y: Calendar.week-row * root.hour-h;
                                    height: root.hour-h;
                                    width: 100%;
                                    border-width: 2px;
                                    border-color: Palette.selected-ring;
                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: Palette.accent;
                                        opacity: 0.14;
                                    }
                                }
                                hour-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        let row = Math.clamp(Math.floor(self.mouse-y / root.hour-h), 0, root.hour-count - 1);
                                        let hour = root.start-hour + row;
                                        Calendar.week-row = row;
                                        Calendar.select-week-day(d);
                                        Chrome.day-list-open = false;
                                        Calendar.open-event-sheet();
                                        Calendar.event-start = hour < 10 ? "0\{hour}:00" : "\{hour}:00";
                                        Calendar.event-end = hour + 1 < 10 ? "0\{hour + 1}:00" : "\{hour + 1}:00";
                                    }
                                }
                            }
                        }
                    }

                    for ev in Calendar.week-events: WeekBlock {
                        ev: ev;
                        hour-h: hour-h;
                        start-hour: start-hour;
                        x: 56px + ev.day * (parent.width - 56px) / 7 + 4px;
                        y: (ev.start-hour - start-hour) * hour-h + 2px;
                        width: (parent.width - 56px) / 7 - 8px;
                        height: ev.hours * hour-h - 6px;
                    }
                }
            }
        }
    }
}
