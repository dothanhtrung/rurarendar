import { AppPage, DayCellData, TimedEvent, DayEvent, AgendaRow, ProfileRow, Palette } from "theme-default.slint";
import { I18n } from "i18n.slint";

export global Chrome {
    in-out property <AppPage> page: AppPage.month;
    in-out property <AppPage> calendar-page: AppPage.month;
    // Event-list mode. True shows only upcoming occurrences that will alert.
    in-out property <bool> list-alerts-only: false;
    // Fixed slots: this Slint build has no array push/remove.
    private property <int> back-depth: 0;
    private property <AppPage> hist0: AppPage.month;
    private property <AppPage> hist1: AppPage.month;
    private property <AppPage> hist2: AppPage.month;
    private property <AppPage> hist3: AppPage.month;
    private property <AppPage> hist4: AppPage.month;
    private property <AppPage> hist5: AppPage.month;
    private property <AppPage> hist6: AppPage.month;
    private property <AppPage> hist7: AppPage.month;
    out property <bool> can-go-back: back-depth > 0;
    // Day, week, and month can take arrow and page keys. Popups and text fields keep them.
    out property <bool> period-keys: popup-depth == 0 && !jump-open && !event-sheet-open && !profile-sheet-open && !day-list-open && !Feeds.sheet-open && (page == AppPage.day || page == AppPage.week || page == AppPage.month);
    in-out property <bool> sidebar-open: true;
    // Set from Rust on Android. Drawer overlay instead of a persistent column.
    in-out property <bool> phone: false;
    in-out property <bool> jump-open: false;
    in-out property <bool> event-sheet-open: false;
    in-out property <bool> profile-sheet-open: false;
    // Event list for a date opened by holding that date.
    in-out property <bool> day-list-open: false;
    private property <int> popup-depth: 0;
    // Bumped so each open menu closes itself. Menus live in different components.
    in-out property <int> close-popup-request: 0;

    public function note-popup(open: bool) {
        if (open) {
            popup-depth += 1;
        } else if (popup-depth > 0) {
            popup-depth -= 1;
        }
    }

    function apply-page(next: AppPage) {
        page = next;
        if (next == AppPage.day || next == AppPage.week || next == AppPage.month) {
            calendar-page = next;
        }
    }

    function remember(current: AppPage) {
        if (back-depth >= 8) {
            hist0 = hist1;
            hist1 = hist2;
            hist2 = hist3;
            hist3 = hist4;
            hist4 = hist5;
            hist5 = hist6;
            hist6 = hist7;
            hist7 = current;
            return;
        }
        if (back-depth == 0) { hist0 = current; }
        if (back-depth == 1) { hist1 = current; }
        if (back-depth == 2) { hist2 = current; }
        if (back-depth == 3) { hist3 = current; }
        if (back-depth == 4) { hist4 = current; }
        if (back-depth == 5) { hist5 = current; }
        if (back-depth == 6) { hist6 = current; }
        if (back-depth == 7) { hist7 = current; }
        back-depth += 1;
    }

    function recall() -> AppPage {
        if (back-depth > 0) {
            back-depth -= 1;
        }
        if (back-depth == 0) { return hist0; }
        if (back-depth == 1) { return hist1; }
        if (back-depth == 2) { return hist2; }
        if (back-depth == 3) { return hist3; }
        if (back-depth == 4) { return hist4; }
        if (back-depth == 5) { return hist5; }
        if (back-depth == 6) { return hist6; }
        return hist7;
    }

    // Remember the current page, then show `next`. Same-page calls do nothing.
    public function open(next: AppPage) {
        if (next == page) {
            return;
        }
        day-list-open = false;
        remember(page);
        apply-page(next);
    }

    // Close the topmost popup or sheet. Does not leave the current page.
    public function dismiss() -> bool {
        if (popup-depth > 0) {
            close-popup-request += 1;
            return true;
        }
        if (event-sheet-open) {
            event-sheet-open = false;
            return true;
        }
        if (profile-sheet-open) {
            profile-sheet-open = false;
            return true;
        }
        if (Feeds.sheet-open) {
            Feeds.sheet-open = false;
            return true;
        }
        if (day-list-open) {
            day-list-open = false;
            return true;
        }
        if (jump-open) {
            jump-open = false;
            return true;
        }
        return false;
    }

    // Same as clicking the focused month day, or the focused week date or hour.
    public function activate() {
        if (page == AppPage.month || (page == AppPage.week && Calendar.week-row < 0)) {
            day-list-open = false;
            open(AppPage.day);
            return;
        }
        if (page != AppPage.week) {
            return;
        }
        day-list-open = false;
        Calendar.open-event-sheet();
        let hour = Calendar.week-hour-start + Calendar.week-row;
        let end = hour + 1;
        Calendar.event-start = hour < 10 ? "0\{hour}:00" : "\{hour}:00";
        Calendar.event-end = end < 10 ? "0\{end}:00" : "\{end}:00";
    }

    // Close the topmost transient layer, or restore the previous page.
    // Returns false when nothing was open, so Android can finish the activity.
    public function go-back() -> bool {
        if (dismiss()) {
            return true;
        }
        if (phone && sidebar-open) {
            sidebar-open = false;
            return true;
        }
        if (back-depth == 0) {
            return false;
        }
        apply-page(recall());
        return true;
    }
}

export global Profiles {
    in-out property <[ProfileRow]> items;
    in-out property <string> active-id;
    in-out property <int> normal-count: 1;
    in-out property <string> sheet-title;
    in-out property <string> sheet-name;
    in-out property <string> sheet-path;
    in-out property <bool> sheet-import: false;
    in-out property <string> sheet-error;
    callback toggle(string);
    callback select(string);
    callback delete(string);
    callback open-create();
    callback open-import();
    callback save-sheet();
}

export global Feeds {
    in-out property <[ProfileRow]> items;
    in-out property <bool> sheet-open: false;
    in-out property <string> sheet-url;
    in-out property <string> sheet-name;
    in-out property <string> sheet-error;
    callback open-add();
    callback save();
    callback toggle(string);
    callback delete(string);
}

export global Sync {
    in-out property <string> server-url: "http://127.0.0.1:8080";
    in-out property <string> username;
    in-out property <string> token;
    in-out property <string> encrypt-key;
    in-out property <string> status: "Chưa có token";
    in-out property <string> error;
    in-out property <bool> logged-in: false;
    callback save-account();
    callback save-encrypt-key();
    callback sync-now();
}

export global Calendar {
    in-out property <int> selected-index: 0;
    in-out property <DayCellData> selected;
    in-out property <[DayCellData]> cells;
    in-out property <[DayCellData]> week-days;
    // -1 is the date header. 0 is the first hour row (week-hour-start).
    in-out property <int> week-row: -1;
    in-out property <int> week-hour-start: 7;
    in-out property <int> week-hour-count: 14;
    in-out property <[TimedEvent]> week-events;
    in-out property <[DayEvent]> day-events;
    in-out property <[DayEvent]> day-popup-items;
    in-out property <[AgendaRow]> upcoming-events;
    in-out property <[AgendaRow]> upcoming-alerts;
    in-out property <string> agenda-status;
    in-out property <string> day-list-status;
    in-out property <[string]> weekdays: ["T2", "T3", "T4", "T5", "T6", "T7", "CN"];
    in-out property <string> period-month-title;
    in-out property <string> period-week-title;
    in-out property <string> period-day-title;
    in-out property <string> period-subtitle;
    in-out property <string> jump-year;
    in-out property <string> jump-month;
    in-out property <string> jump-day;
    in-out property <string> jump-error;
    // Empty while creating. Set to the local integer event ID while editing.
    in-out property <string> editing-id;
    in-out property <string> event-title;
    in-out property <string> event-basis: "gregorian";
    in-out property <string> event-date;
    in-out property <string> event-lunar-year;
    in-out property <string> event-lunar-month;
    in-out property <string> event-lunar-day;
    in-out property <bool> event-lunar-leap: false;
    in-out property <bool> event-all-day: false;
    in-out property <string> event-start;
    in-out property <string> event-end;
    in-out property <bool> event-reminder-on: false;
    in-out property <string> event-reminder;
    in-out property <int> event-recurrence-index: 0;
    in-out property <[string]> event-recurrence-options: ["Không lặp", "Hàng ngày", "Hàng tuần", "Hàng tháng", "Hàng năm"];
    in-out property <string> event-error;
    // Scope for enable / disable / delete. Day view offers this day and the series.
    // Week and month also offer that period. Index 0 is always this day.
    in-out property <int> event-scope-index: 0;
    in-out property <[string]> event-scope-options: ["Ngày này", "Cả chuỗi"];
    in-out property <bool> event-scope-has-period: false;
    in-out property <string> event-status;

    callback prev-period();
    callback next-period();
    // Move the focused day by `delta`. True when that day leaves the visible page.
    callback step-day(int) -> bool;
    callback go-today();
    callback select-cell(int);
    callback select-week-day(int);
    callback jump-to();
    callback open-event-sheet();
    callback open-event(string);
    // Open the event, and treat year-month-day as the occurrence "this day" acts on.
    callback open-listed-event(string, int, int, int);
    callback save-event();
    // action: 0 disable, 1 enable, 2 delete. Always the event, for the chosen scope.
    callback apply-item-action(int);
    // Remove the whole event. One day or one period is deleted from the editor.
    callback delete-event(string);

    public pure function weekday-name(index: int) -> string {
        return I18n.weekdays-long[Math.mod(index, 7)];
    }

    public pure function lunar-month-name(m: int) -> string {
        if (m < 1) {
            return I18n.lunar-months[0];
        }
        if (m > 12) {
            return I18n.lunar-months[11];
        }
        return I18n.lunar-months[m - 1];
    }

    public pure function greg-month-name(m: int) -> string {
        if (m < 1) {
            return I18n.greg-months[0];
        }
        if (m > 12) {
            return I18n.greg-months[11];
        }
        return I18n.greg-months[m - 1];
    }

    public pure function cell-kind-bg(cell: DayCellData) -> brush {
        if (cell.holiday) {
            return Palette.bg-day-holiday;
        }
        if (cell.tiet-khi) {
            return Palette.bg-day-tiet-khi;
        }
        if (cell.weekend) {
            return Palette.bg-day-weekend;
        }
        return Palette.bg-day-weekday;
    }
}

// Short motion. `enabled` is the Settings switch; duration 0 skips the animation.
export global Motion {
    in-out property <bool> enabled: true;
    // +1: the next period enters from the right. -1: the previous period enters from the left.
    in-out property <int> period-dir: 1;
    in-out property <int> period-seq: 0;
    callback save-enabled();

    public function period(next: bool) {
        if (next) {
            Calendar.next-period();
        } else {
            Calendar.prev-period();
        }
        period-dir = next ? 1 : -1;
        period-seq += 1;
    }

    // One day. The month page slides only when that day leaves its six-week grid.
    public function focus-day(next: bool) {
        step-days(next ? 1 : -1);
    }

    // One row of the month grid. Down is the later week.
    public function focus-row(down: bool) {
        step-days(down ? 7 : -7);
    }

    // One row of the week column. -1 is the date; then the hour rows.
    public function focus-week-row(down: bool) {
        if (Calendar.week-row < 0) {
            if (down) {
                Calendar.week-row = 0;
            }
            return;
        }
        if (down) {
            Calendar.week-row = Math.min(Calendar.week-row + 1, Calendar.week-hour-count - 1);
        } else if (Calendar.week-row == 0) {
            Calendar.week-row = -1;
        } else {
            Calendar.week-row -= 1;
        }
    }

    // Day page: one week. Week and month pages: the same step as the header buttons.
    public function page(next: bool) {
        if (Chrome.page == AppPage.day) {
            step-days(next ? 7 : -7);
        } else {
            period(next);
        }
    }

    function step-days(delta: int) {
        if (Calendar.step-day(delta)) {
            period-dir = delta < 0 ? -1 : 1;
            period-seq += 1;
        }
    }
}
